APP_ENV=development
DATABASE_URL=postgresql+psycopg://recruitflow:change-me-for-local-development@localhost:5432/recruitflow
FRONTEND_ORIGIN=http://localhost:3000
LOCAL_OWNER_ID=00000000-0000-0000-0000-000000000001
RESUME_STORAGE_PATH=../data/resumes
AI_PROVIDER=gemini
AI_FALLBACK_ENABLED=false
AI_FALLBACK_PROVIDER=openrouter
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=replace-with-an-explicit-free-model-id-ending-in-colon-free
OPENROUTER_TIMEOUT_SECONDS=30
GMAIL_OAUTH_CLIENT_ID=replace-with-google-oauth-web-client-id
GMAIL_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8001/api/gmail/oauth/callback
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
GMAIL_HTTP_TIMEOUT_SECONDS=30

